# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in values. Never commit real secrets.
# All variables are OPTIONAL for local dev — the app runs with safe defaults.
# Validation/typing lives in src/lib/env.ts.
# ----------------------------------------------------------------------------

# --- Public (inlined into the client bundle at BUILD time) ------------------

# Absolute site URL used for canonical links, sitemap, and Open Graph metadata.
# Because it is a NEXT_PUBLIC_* value it is baked in at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never exposed to the browser) -----------------------------

# Resend API key for delivering the contact form (https://resend.com, free tier).
# If unset, contact submissions are accepted but not emailed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# "From" address for contact emails. Must be a verified Resend sender;
# falls back to onboarding@resend.dev when unset.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Random salt for one-way hashing of client IPs in logs (privacy).
# Generate one with:  openssl rand -hex 16
IP_HASH_SALT=replace-with-a-long-random-string

# ----------------------------------------------------------------------------
# CI/CD — set these in GitHub repo settings, NOT in a local .env file.
# Settings -> Secrets and variables -> Actions
# ----------------------------------------------------------------------------

# Secrets (Actions secrets):
#   DOCKERHUB_USERNAME   Docker Hub account name           (cd.yml build-push)
#   DOCKERHUB_TOKEN      Docker Hub access token           (cd.yml build-push)
#   VERCEL_TOKEN         Vercel personal token             (cd.yml, pr-preview.yml)
#   VERCEL_ORG_ID        from .vercel/project.json         (cd.yml, pr-preview.yml)
#   VERCEL_PROJECT_ID    from .vercel/project.json         (cd.yml, pr-preview.yml)
#
# Variables (Actions variables):
#   NEXT_PUBLIC_SITE_URL Production URL baked into the pushed Docker image (cd.yml)
