# Copy to .env.local and fill in. None are strictly required to run locally.

# Absolute site URL — used for canonical links, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact form email delivery via Resend (https://resend.com — free tier).
# If unset, the /api/contact route logs submissions instead of emailing.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- CI/CD secrets (set these in GitHub repo Settings → Secrets, not here) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
